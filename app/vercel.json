{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "headers": [
    { "source": "/(.*)\\.(js|wasm|ttf|otf|jpg|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
